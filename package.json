{
  "name": "vaultbill",
  "private": true,
  "version": "0.1.0",
  "author": "VaultBill",
  "type": "module",
  "description": "VaultBill JSON-first billing, print, and reporting platform.",
  "main": "dist-electron/Main.js",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "dev:electron": "npm run build:electron && concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --no-file-parallelism --maxWorkers=1",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "coverage:ci": "vitest run --coverage --no-file-parallelism --maxWorkers=1",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:desktop": "npm run build:web && npm run build:electron",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "package:desktop": "electron-builder --config electron-builder.config.cjs --dir --publish never",
    "package:desktop:installer": "electron-builder --config electron-builder.config.cjs --publish never",
    "smoke:first-run-db": "vitest run src/db/startup",
    "smoke:first-run-db:ci": "vitest run --no-file-parallelism --maxWorkers=1 src/db/startup",
    "smoke:installer": "node scripts/installer-smoke.mjs",
    "smoke:installer:required": "node scripts/installer-smoke.mjs --require-installer",
    "audit:security": "npm audit --audit-level=critical",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "test:security": "vitest run src/security src/engines/printEngine/TemplateHtmlSanitizer.test.ts src/db/adapters/localApiAdapter.test.ts",
    "security:check": "node scripts/security-check.mjs",
    "release:checksums": "node scripts/generate-checksums.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "release:desktop": "npm run build:web && npm run rebuild:native && npm run build:electron && npm run package:desktop:installer && npm run smoke:installer:required && npm run smoke:first-run-db:ci && npm run release:notes",
    "preview": "vite preview",
    "commitlint": "commitlint --from HEAD~1 --to HEAD"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{json,md,scss,yml,yaml,html}": "prettier --write"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.17.0",
    "ts-pattern": "^5.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.5.3",
    "sass": "^1.89.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.3"
  }
}
